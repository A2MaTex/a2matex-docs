Project A2MaTeX_build_review_signing {
  database_type: 'PostgreSQL'
  Note: '''Build, Review & Signing module view.

Tables in the primary module group are complete. Tables in reference_stubs are intentionally reduced cross-module projections used only to preserve readable relationships in dbdiagram.io.

The canonical schema remains 10-database-design.dbml.'''
}

// ============================================================

Enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

Enum ProjectStatus {
  ACTIVE
  ARCHIVED
  SUSPENDED
}

Enum StorageObjectStatus {
  PENDING
  AVAILABLE
  QUARANTINED
  DELETED
}

Enum SubmissionStatus {
  SUBMITTED
  VALIDATING
  BUILDING
  SANDBOXING
  IN_REVIEW
  CHANGES_REQUESTED
  REJECTED
  ESCALATED
  APPROVED
  SIGNING
  PUBLISHED
  CANCELLED
  FAILED
}

Enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

Enum ValidationStage {
  UPLOAD
  STRUCTURE
  SOURCE
  CAPABILITY
  PACKAGE
  SANDBOX
}

Enum FindingSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

Enum ReviewDecisionType {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  ESCALATED
}

Enum ArtifactKind {
  CANDIDATE
  SIGNED
}

Enum ArtifactStatus {
  CREATED
  VERIFIED
  SIGNED
  PUBLISHED
  QUARANTINED
  REVOKED
  DELETED
}

Enum SigningKeyStatus {
  ACTIVE
  RETIRED
  COMPROMISED
  REVOKED
}

Enum ProductVersionStatus {
  DRAFT
  APPROVED
  PUBLISHED
  DEPRECATED
  REVOKED
}

// ============================================================

Table Submission {
  id uuid [pk, default: `gen_random_uuid()`]
  projectId uuid [not null, ref: > Project.id]
  revisionId uuid [not null, ref: > WorkflowRevision.id]
  submittedByUserId uuid [not null, ref: > User.id]
  status SubmissionStatus [not null, default: 'SUBMITTED']
  targetVersion varchar(64) [not null, note: 'Publisher-proposed Product Version string.']
  releaseNotes text
  previousPublishedVersionId uuid [ref: >? ProductVersion.id, note: 'Baseline used by diff when this is an update.']
  currentBuildAttemptId uuid [note: 'Application-maintained pointer for fast status display; FK added after BuildAttempt exists.']
  submittedAt timestamptz [not null, default: `now()`]
  decidedAt timestamptz
  cancelledAt timestamptz
  failureCode varchar(120)
  failureMessage text

  indexes {
    (projectId, submittedAt) [name: 'idx_submissions_project_time']
    (status, submittedAt) [name: 'idx_submissions_queue']
    revisionId [name: 'idx_submissions_revision']
  }

  Note: 'Review request for exactly one immutable Revision. Status may change, but the Revision association may not.'
}

Table BuildAttempt {
  id uuid [pk, default: `gen_random_uuid()`]
  submissionId uuid [not null, ref: > Submission.id]
  attemptNumber int [not null]
  status JobStatus [not null, default: 'QUEUED']
  toolchainVersion varchar(120) [not null]
  workerRef varchar(255)
  sourceSnapshotHash char(64) [not null]
  candidateArtifactId uuid [note: 'Set after a candidate Artifact is created; FK added after Artifact exists.']
  queuedAt timestamptz [not null, default: `now()`]
  startedAt timestamptz
  finishedAt timestamptz
  failureCode varchar(120)
  failureMessage text

  indexes {
    (submissionId, attemptNumber) [unique, name: 'uq_build_attempts_submission_attempt']
    (status, queuedAt) [name: 'idx_build_attempts_queue']
  }

  Note: 'One idempotent build attempt. Infrastructure failure creates/retries an attempt and must not be represented as Reviewer rejection.'
}

Table ValidationRun {
  id uuid [pk, default: `gen_random_uuid()`]
  submissionId uuid [not null, ref: > Submission.id]
  buildAttemptId uuid [ref: >? BuildAttempt.id]
  stage ValidationStage [not null]
  status JobStatus [not null]
  policyVersion varchar(80) [not null]
  summaryJson jsonb [note: 'Counts and sanitized summary only.']
  reportObjectId uuid [ref: >? StorageObject.id, note: 'Optional detailed sanitized report.']
  startedAt timestamptz [not null]
  finishedAt timestamptz

  indexes {
    (submissionId, stage, startedAt) [name: 'idx_validation_runs_submission_stage']
  }

  Note: 'Automated validation execution for upload, structure, source, capability, package, or sandbox stages.'
}

Table ValidationFinding {
  id uuid [pk, default: `gen_random_uuid()`]
  validationRunId uuid [not null, ref: > ValidationRun.id]
  severity FindingSeverity [not null]
  ruleCode varchar(160) [not null]
  nodeId uuid
  sourcePath text
  sourceLine int
  message text [not null]
  metadataJson jsonb [note: 'Sanitized diagnostic metadata; never include secret values or full sensitive payloads.']
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (validationRunId, severity) [name: 'idx_validation_findings_severity']
    (ruleCode, createdAt) [name: 'idx_validation_findings_rule']
  }

  Note: 'Machine-generated diagnostic and security findings linked to a validation run.'
}

Table SandboxRun {
  id uuid [pk, default: `gen_random_uuid()`]
  buildAttemptId uuid [not null, ref: > BuildAttempt.id]
  status JobStatus [not null]
  fixtureSetVersion varchar(80)
  durationMs bigint
  peakMemoryBytes bigint
  networkRequestCount int [not null, default: 0]
  outputBytes bigint [not null, default: 0]
  resultSummaryJson jsonb
  reportObjectId uuid [ref: >? StorageObject.id]
  startedAt timestamptz [not null]
  finishedAt timestamptz
  failureCode varchar(120)

  Note: 'Sandbox test of a candidate using fake credentials, mock HTTP, and fake device capabilities.'
}

Table Artifact {
  id uuid [pk, default: `gen_random_uuid()`]
  buildAttemptId uuid [not null, ref: > BuildAttempt.id]
  kind ArtifactKind [not null]
  sourceCandidateArtifactId uuid [ref: >? Artifact.id, note: 'Required for SIGNED Artifact; null for CANDIDATE Artifact.']
  storageObjectId uuid [not null, ref: > StorageObject.id]
  payloadHash char(64) [not null, note: 'Canonical reviewed payload hash. Candidate and derived signed Artifact must share this value.']
  packageHash char(64) [not null, unique, note: 'Hash of the complete stored archive bytes.']
  manifestHash char(64) [not null]
  packageFormatVersion varchar(32) [not null]
  runtimeVersionRange varchar(120) [not null]
  sizeBytes bigint [not null]
  status ArtifactStatus [not null, default: 'CREATED']
  createdAt timestamptz [not null, default: `now()`]
  verifiedAt timestamptz
  retentionUntil timestamptz

  indexes {
    (buildAttemptId, kind) [name: 'idx_artifacts_build_kind']
    payloadHash [name: 'idx_artifacts_payload_hash']
    (status, retentionUntil) [name: 'idx_artifacts_retention']
  }

  Note: 'Immutable .apkg metadata. A SIGNED Artifact derives from a reviewed CANDIDATE and preserves its payloadHash even if the full packageHash changes when signature.sig is added.'
}

Table ReviewAssignment {
  id uuid [pk, default: `gen_random_uuid()`]
  submissionId uuid [not null, ref: > Submission.id]
  reviewerUserId uuid [not null, ref: > User.id]
  assignedByUserId uuid [ref: >? User.id]
  status varchar(32) [not null, default: 'ASSIGNED']
  assignedAt timestamptz [not null, default: `now()`]
  completedAt timestamptz

  indexes {
    (submissionId, reviewerUserId) [unique, name: 'uq_review_assignments_reviewer']
    (reviewerUserId, status, assignedAt) [name: 'idx_review_assignments_queue']
  }

  Note: 'Reviewer work assignment. Multiple rows allow future two-person or specialist review without changing Submission ownership.'
}

Table ReviewFinding {
  id uuid [pk, default: `gen_random_uuid()`]
  submissionId uuid [not null, ref: > Submission.id]
  reviewerUserId uuid [not null, ref: > User.id]
  severity FindingSeverity [not null]
  category varchar(100) [not null]
  nodeId uuid
  title varchar(255) [not null]
  description text [not null]
  resolutionStatus varchar(32) [not null, default: 'OPEN']
  createdAt timestamptz [not null, default: `now()`]
  resolvedAt timestamptz

  indexes {
    (submissionId, severity) [name: 'idx_review_findings_submission_severity']
  }

  Note: 'Human review findings. They describe risk and requested correction but do not mutate the submitted Revision.'
}

Table ReviewDecision {
  id uuid [pk, default: `gen_random_uuid()`]
  submissionId uuid [not null, ref: > Submission.id]
  reviewerUserId uuid [not null, ref: > User.id]
  candidateArtifactId uuid [not null, ref: > Artifact.id]
  decision ReviewDecisionType [not null]
  approvedPayloadHash char(64) [not null, note: 'Must equal the payloadHash of candidateArtifactId; signing verifies this invariant again.']
  policyVersion varchar(80) [not null]
  reason text [not null]
  decidedAt timestamptz [not null, default: `now()`]

  indexes {
    (submissionId, decidedAt) [name: 'idx_review_decisions_submission_time']
    (candidateArtifactId, decision) [name: 'idx_review_decisions_artifact_decision']
  }

  Note: 'Append-only human decision tied to one exact candidate payload hash. A later decision is a new row, never an overwrite.'
}

Table SigningKey {
  id uuid [pk, default: `gen_random_uuid()`]
  keyRef varchar(255) [not null, unique, note: 'Opaque KMS/HSM key reference; private key material never enters PostgreSQL.']
  algorithm varchar(80) [not null]
  publicKeyPem text [not null]
  keyVersion varchar(80) [not null]
  status SigningKeyStatus [not null]
  validFrom timestamptz [not null]
  validUntil timestamptz
  createdAt timestamptz [not null, default: `now()`]
  retiredAt timestamptz

  Note: 'Signing-key metadata and public verification material. Production private keys remain isolated in KMS/HSM.'
}

Table ArtifactSignature {
  id uuid [pk, default: `gen_random_uuid()`]
  signedArtifactId uuid [not null, unique, ref: - Artifact.id]
  candidateArtifactId uuid [not null, ref: > Artifact.id]
  reviewDecisionId uuid [not null, ref: > ReviewDecision.id]
  signingKeyId uuid [not null, ref: > SigningKey.id]
  signedPayloadHash char(64) [not null]
  signatureValue text [not null, note: 'Detached/base64 signature or signature metadata; not a private key.']
  signedAt timestamptz [not null, default: `now()`]
  verifiedAt timestamptz

  Note: 'Cryptographic proof that the exact approved candidate payload was signed by a platform key.'
}

// ============================================================

Table ProductVersion {
  id uuid [pk]
  version varchar(64)
  status ProductVersionStatus
  publishedAt timestamptz
  createdAt timestamptz

  Note: 'Reference stub for a table owned by another module. Only identity fields are shown here; use the owning module file for the complete definition.'
}

Table Project {
  id uuid [pk]
  name varchar(180)
  projectKey varchar(100)
  status ProjectStatus
  createdAt timestamptz

  Note: 'Reference stub for a table owned by another module. Only identity fields are shown here; use the owning module file for the complete definition.'
}

Table StorageObject {
  id uuid [pk]
  objectKey text
  status StorageObjectStatus
  contentHash char(64)
  createdAt timestamptz

  Note: 'Reference stub for a table owned by another module. Only identity fields are shown here; use the owning module file for the complete definition.'
}

Table User {
  id uuid [pk]
  username varchar(255)
  email text
  status UserStatus
  createdAt timestamptz

  Note: 'Reference stub for a table owned by another module. Only identity fields are shown here; use the owning module file for the complete definition.'
}

Table WorkflowRevision {
  id uuid [pk]
  revisionNumber int
  semanticHash char(64)
  createdAt timestamptz

  Note: 'Reference stub for a table owned by another module. Only identity fields are shown here; use the owning module file for the complete definition.'
}

// ============================================================

Ref: Submission.currentBuildAttemptId >? BuildAttempt.id
Ref: BuildAttempt.candidateArtifactId >? Artifact.id

