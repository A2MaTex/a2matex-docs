Project A2MaTeX_platform_operations {
  database_type: 'PostgreSQL'
  Note: '''Platform Operations module view.

Tables in the primary module group are complete. Tables in reference_stubs are intentionally reduced cross-module projections used only to preserve readable relationships in dbdiagram.io.

The canonical schema remains 10-database-design.dbml.'''
}

// ============================================================

Enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

Enum StorageObjectStatus {
  PENDING
  AVAILABLE
  QUARANTINED
  DELETED
}

Enum ArtifactKind {
  CANDIDATE
  SIGNED
}

Enum ArtifactStatus {
  CREATED
  VERIFIED
  SIGNED
  PUBLISHED
  QUARANTINED
  REVOKED
  DELETED
}

Enum SigningKeyStatus {
  ACTIVE
  RETIRED
  COMPROMISED
  REVOKED
}

Enum ProductStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

Enum ProductVersionStatus {
  DRAFT
  APPROVED
  PUBLISHED
  DEPRECATED
  REVOKED
}

Enum LauncherDeviceStatus {
  ACTIVE
  BLOCKED
  RETIRED
}

Enum RevocationTargetType {
  ACCOUNT
  DEVICE
  PRODUCT
  PRODUCT_VERSION
  ARTIFACT
  SIGNING_KEY
}

Enum RevocationSeverity {
  STANDARD
  URGENT
  SECURITY_CRITICAL
}

Enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

// ============================================================

Table StorageObject {
  id uuid [pk, default: `gen_random_uuid()`]
  bucket varchar(120) [not null]
  objectKey text [not null]
  objectVersion varchar(255)
  contentHash char(64) [not null, note: 'SHA-256 hex digest of the stored bytes.']
  sizeBytes bigint [not null]
  mimeType varchar(255)
  status StorageObjectStatus [not null, default: 'PENDING']
  encryptionKeyRef varchar(255) [note: 'Opaque KMS reference; never cryptographic key material.']
  retentionUntil timestamptz
  createdByUserId uuid [ref: >? User.id]
  createdAt timestamptz [not null, default: `now()`]
  verifiedAt timestamptz
  deletedAt timestamptz

  indexes {
    (bucket, objectKey, objectVersion) [unique, name: 'uq_storage_objects_location_version']
    contentHash [name: 'idx_storage_objects_hash']
    (status, retentionUntil) [name: 'idx_storage_objects_retention']
  }

  Note: 'Metadata for snapshots, assets, reports, and .apkg files stored outside PostgreSQL. Object bytes are never duplicated in this table.'
}

Table Revocation {
  id uuid [pk, default: `gen_random_uuid()`]
  targetType RevocationTargetType [not null]
  accountId uuid [ref: >? User.id]
  launcherDeviceId uuid [ref: >? LauncherDevice.id]
  productId uuid [ref: >? Product.id]
  productVersionId uuid [ref: >? ProductVersion.id]
  artifactId uuid [ref: >? Artifact.id]
  signingKeyId uuid [ref: >? SigningKey.id]
  severity RevocationSeverity [not null, default: 'STANDARD']
  reasonCode varchar(120) [not null]
  reason text [not null]
  effectiveAt timestamptz [not null]
  expiresAt timestamptz
  createdByUserId uuid [not null, ref: > User.id]
  createdAt timestamptz [not null, default: `now()`]
  liftedByUserId uuid [ref: >? User.id]
  liftedAt timestamptz

  indexes {
    (targetType, effectiveAt) [name: 'idx_revocations_target_time']
    (productId, liftedAt) [name: 'idx_revocations_product_active']
    (productVersionId, liftedAt) [name: 'idx_revocations_version_active']
    (launcherDeviceId, liftedAt) [name: 'idx_revocations_device_active']
  }

  Note: 'Central revocation record. A PostgreSQL CHECK must require exactly one target FK matching targetType. Revocation preserves history and does not imply deletion.'
}

Table AuditEvent {
  id uuid [pk, default: `gen_random_uuid()`]
  correlationId uuid
  actorUserId uuid [ref: >? User.id]
  actorType varchar(40) [not null, note: 'USER, SERVICE, or SYSTEM.']
  action varchar(160) [not null]
  targetType varchar(100) [not null]
  targetId uuid
  result varchar(32) [not null]
  reason text
  ipAddress varchar(64) [note: 'Consider hashing/truncation according to privacy policy.']
  userAgentHash char(64)
  metadataJson jsonb [note: 'Sanitized immutable context; never credentials or raw business payloads.']
  occurredAt timestamptz [not null, default: `now()`]
  retentionUntil timestamptz [not null]

  indexes {
    (targetType, targetId, occurredAt) [name: 'idx_audit_events_target_time']
    (actorUserId, occurredAt) [name: 'idx_audit_events_actor_time']
    correlationId [name: 'idx_audit_events_correlation']
    retentionUntil [name: 'idx_audit_events_retention']
  }

  Note: 'Append-only security and administrative audit trail. Partition by occurredAt and protect against UPDATE/DELETE outside controlled retention jobs.'
}

Table IdempotencyKey {
  id uuid [pk, default: `gen_random_uuid()`]
  scope varchar(120) [not null, note: 'Business operation such as submission.create, entitlement.grant, or lease.issue.']
  actorId uuid [not null]
  idempotencyKey varchar(255) [not null]
  requestHash char(64) [not null]
  responseStatus int
  responseRef varchar(255) [note: 'Reference to created resource rather than a full sensitive response body.']
  lockedUntil timestamptz
  expiresAt timestamptz [not null]
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (scope, actorId, idempotencyKey) [unique, name: 'uq_idempotency_keys_scope_actor_key']
    expiresAt [name: 'idx_idempotency_keys_expiry']
  }

  Note: 'Prevents duplicate Submission, grants, builds, or lease issuance when API clients retry.'
}

Table OutboxEvent {
  id uuid [pk, default: `gen_random_uuid()`]
  aggregateType varchar(100) [not null]
  aggregateId uuid [not null]
  eventType varchar(160) [not null]
  payloadJson jsonb [not null, note: 'Minimal integration event; exclude secrets and unnecessary customer payloads.']
  status OutboxStatus [not null, default: 'PENDING']
  availableAt timestamptz [not null, default: `now()`]
  attemptCount int [not null, default: 0]
  lastError text
  createdAt timestamptz [not null, default: `now()`]
  publishedAt timestamptz

  indexes {
    (status, availableAt) [name: 'idx_outbox_events_dispatch']
    (aggregateType, aggregateId, createdAt) [name: 'idx_outbox_events_aggregate']
  }

  Note: 'Transactional outbox for reliable asynchronous transitions such as BuildRequested, SubmissionApproved, VersionPublished, EntitlementChanged, and ProductRevoked.'
}

