Project A2MaTeX_authoring_revision {
  database_type: 'PostgreSQL'
  Note: '''Authoring & Revision module view.

Tables in the primary module group are complete. Tables in reference_stubs are intentionally reduced cross-module projections used only to preserve readable relationships in dbdiagram.io.

The canonical schema remains 10-database-design.dbml.'''
}

// ============================================================

Enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

Enum PublisherStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

Enum ProjectStatus {
  ACTIVE
  ARCHIVED
  SUSPENDED
}

Enum StorageObjectStatus {
  PENDING
  AVAILABLE
  QUARANTINED
  DELETED
}

// ============================================================

Table Project {
  id uuid [pk, default: `gen_random_uuid()`]
  publisherId uuid [not null, ref: > Publisher.id]
  projectKey varchar(100) [not null, note: 'Stable Publisher-scoped key assigned when a local project becomes registered.']
  name varchar(180) [not null]
  description text
  status ProjectStatus [not null, default: 'ACTIVE']
  latestRevisionNumber int [not null, default: 0]
  createdByUserId uuid [not null, ref: > User.id]
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]
  archivedAt timestamptz

  indexes {
    (publisherId, projectKey) [unique, name: 'uq_projects_publisher_key']
    (publisherId, status) [name: 'idx_projects_publisher_status']
  }

  Note: 'Server-registered project. Local-only Project do not create rows and therefore are not subject to Registered Project Slot limits.'
}

Table WorkflowDraft {
  id uuid [pk, default: `gen_random_uuid()`]
  projectId uuid [not null, unique, ref: - Project.id]
  graphJson jsonb [not null, note: 'Mutable graph including node/edge configuration and layout, but not large source or asset bytes.']
  graphSchemaVersion varchar(32) [not null]
  contentHash char(64) [not null, note: 'Hash of the normalized current Draft used for conflict detection and no-op sync.']
  lockVersion int [not null, default: 1, note: 'Optimistic locking. UPDATE must include the previously read lockVersion.']
  lastSyncedByUserId uuid [not null, ref: > User.id]
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  Note: 'Single mutable server Draft per Registered Project during UAT. Local autosave does not create server rows on each keystroke.'
}

Table DraftNodeSource {
  id uuid [pk, default: `gen_random_uuid()`]
  draftId uuid [not null, ref: > WorkflowDraft.id]
  nodeId uuid [not null, note: 'Stable node UUID generated by Studio.']
  language varchar(32) [not null, default: 'TYPESCRIPT']
  sourceText text [not null]
  sourceHash char(64) [not null]
  lockVersion int [not null, default: 1]
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    (draftId, nodeId) [unique, name: 'uq_draft_node_sources_node']
  }

  Note: 'Mutable source of Custom Nodes in the synchronized Draft. Per-node separation avoids rewriting the full graph for each code edit.'
}

Table SourceBlob {
  id uuid [pk, default: `gen_random_uuid()`]
  contentHash char(64) [not null]
  language varchar(32) [not null]
  sourceText text [not null, note: 'Immutable source text; maximum size is enforced by configurable policy.']
  sizeBytes bigint [not null]
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (contentHash, language) [unique, name: 'uq_source_blobs_hash_language']
  }

  Note: 'Content-addressed immutable source storage shared by Revisions to reduce duplicate Custom Node source.'
}

Table WorkflowRevision {
  id uuid [pk, default: `gen_random_uuid()`]
  projectId uuid [not null, ref: > Project.id]
  revisionNumber int [not null]
  graphJson jsonb [not null, note: 'Immutable graph snapshot. Source is referenced through RevisionNode.']
  graphSchemaVersion varchar(32) [not null]
  graphHash char(64) [not null]
  semanticHash char(64) [not null, note: 'Excludes visual-only layout fields.']
  visualHash char(64) [not null, note: 'Hash of positions, viewport, colors, and other editor-only fields.']
  capabilityHash char(64) [not null, note: 'Hash of declared capability, domain, credential-slot, and side-effect set.']
  snapshotObjectId uuid [not null, ref: > StorageObject.id, note: 'Compressed immutable submission snapshot in object storage.']
  snapshotSizeBytes bigint [not null]
  fileCount int [not null]
  createdByUserId uuid [not null, ref: > User.id]
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (projectId, revisionNumber) [unique, name: 'uq_workflow_revisions_project_number']
    (projectId, graphHash) [name: 'idx_workflow_revisions_project_hash']
  }

  Note: 'Immutable revision frozen before submission. No updatedAt by design; correcting content requires a new revision.'
}

Table RevisionNode {
  id uuid [pk, default: `gen_random_uuid()`]
  revisionId uuid [not null, ref: > WorkflowRevision.id]
  nodeId uuid [not null, note: 'Stable workflow node identity, not this row primary key.']
  nodeTypeKey varchar(160) [not null]
  nodeDefinitionVersion varchar(64)
  sourceBlobId uuid [ref: >? SourceBlob.id, note: 'Null for System Nodes without Publisher source.']
  semanticHash char(64) [not null]
  visualHash char(64) [not null]
  capabilityHash char(64) [not null]
  responsibility text [note: 'Publisher-facing summary used by review and God Node risk analysis.']
  sideEffects jsonb [note: 'Normalized side-effect declarations; must not contain credentials or payload data.']
  resourcePolicy jsonb
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (revisionId, nodeId) [unique, name: 'uq_revision_nodes_node']
    (revisionId, capabilityHash) [name: 'idx_revision_nodes_capability_hash']
  }

  Note: 'Immutable per-node projection optimized for O(n) revision diff, review, and source tracing. Canonical graph semantics remain in WorkflowRevision.graphJson.'
}

Table ProjectAsset {
  id uuid [pk, default: `gen_random_uuid()`]
  projectId uuid [not null, ref: > Project.id]
  logicalPath text [not null]
  storageObjectId uuid [not null, ref: > StorageObject.id]
  contentHash char(64) [not null]
  mimeType varchar(255)
  sizeBytes bigint [not null]
  createdByUserId uuid [not null, ref: > User.id]
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]
  deletedAt timestamptz

  indexes {
    (projectId, logicalPath) [unique, name: 'uq_project_assets_path']
  }

  Note: 'Mutable project asset catalog. Revisions reference immutable snapshots through RevisionAsset.'
}

Table RevisionAsset {
  revisionId uuid [not null, ref: > WorkflowRevision.id]
  projectAssetId uuid [not null, ref: > ProjectAsset.id]
  storageObjectId uuid [not null, ref: > StorageObject.id]
  logicalPath text [not null]
  contentHash char(64) [not null]
  sizeBytes bigint [not null]

  indexes {
    (revisionId, logicalPath) [pk]
    storageObjectId [name: 'idx_revision_assets_storage']
  }

  Note: 'Immutable asset manifest captured by a Revision. It prevents later Project Asset replacement from changing submitted content.'
}

// ============================================================

Table Publisher {
  id uuid [pk]
  displayName varchar(180)
  slug varchar(120)
  status PublisherStatus
  createdAt timestamptz

  Note: 'Reference stub for a table owned by another module. Only identity fields are shown here; use the owning module file for the complete definition.'
}

Table StorageObject {
  id uuid [pk]
  objectKey text
  status StorageObjectStatus
  contentHash char(64)
  createdAt timestamptz

  Note: 'Reference stub for a table owned by another module. Only identity fields are shown here; use the owning module file for the complete definition.'
}

Table User {
  id uuid [pk]
  username varchar(255)
  email text
  status UserStatus
  createdAt timestamptz

  Note: 'Reference stub for a table owned by another module. Only identity fields are shown here; use the owning module file for the complete definition.'
}
