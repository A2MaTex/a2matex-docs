Project A2MaTeX_runtime_telemetry {
  database_type: 'PostgreSQL'
  Note: '''Runtime & Telemetry module view.

Tables in the primary module group are complete. Tables in reference_stubs are intentionally reduced cross-module projections used only to preserve readable relationships in dbdiagram.io.

The canonical schema remains 10-database-design.dbml.'''
}

// ============================================================

Enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

Enum ProjectStatus {
  ACTIVE
  ARCHIVED
  SUSPENDED
}

Enum ProductStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

Enum ProductVersionStatus {
  DRAFT
  APPROVED
  PUBLISHED
  DEPRECATED
  REVOKED
}

Enum LauncherDeviceStatus {
  ACTIVE
  BLOCKED
  RETIRED
}

Enum PermissionDecision {
  ALLOWED
  DENIED
  REVOKED
}

Enum LeaseStatus {
  ACTIVE
  EXPIRED
  REVOKED
  SUPERSEDED
}

Enum ExecutionEnvironment {
  DEVELOPMENT
  PRODUCTION
}

Enum ExecutionStatus {
  CREATED
  VALIDATING
  RUNNING
  CANCEL_REQUESTED
  SUCCEEDED
  FAILED
  CANCELLED
}

Enum NodeExecutionStatus {
  PENDING
  READY
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

Enum CapabilityInvocationStatus {
  REQUESTED
  ALLOWED
  DENIED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

// ============================================================

Table Execution {
  id uuid [pk, default: `gen_random_uuid()`]
  environment ExecutionEnvironment [not null]
  userId uuid [ref: >? User.id, note: 'May be null for a purely local development run not uploaded to the platform.']
  launcherDeviceId uuid [ref: >? LauncherDevice.id]
  productId uuid [ref: >? Product.id]
  productVersionId uuid [ref: >? ProductVersion.id]
  projectId uuid [ref: >? Project.id]
  revisionId uuid [ref: >? WorkflowRevision.id]
  licenseLeaseId uuid [ref: >? LicenseLease.id, note: 'Required for PRODUCTION execution.']
  packagePayloadHash char(64)
  correlationId uuid [not null, unique]
  status ExecutionStatus [not null, default: 'CREATED']
  triggerType varchar(80)
  startedAt timestamptz
  finishedAt timestamptz
  durationMs bigint
  errorCode varchar(120)
  errorMessageSanitized text
  retryCount int [not null, default: 0]
  permissionDeniedCount int [not null, default: 0]
  resourceViolationCount int [not null, default: 0]
  telemetryConsent boolean [not null, default: false]
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (productVersionId, startedAt) [name: 'idx_executions_product_version_time']
    (userId, startedAt) [name: 'idx_executions_user_time']
    (status, startedAt) [name: 'idx_executions_status_time']
    (launcherDeviceId, createdAt) [name: 'idx_executions_device_time']
  }

  Note: 'One workflow run. Store metadata and sanitized errors only; never store raw request, response, OCR, file, token, email, or location payload by default. Partition by startedAt when volume requires.'
}

Table NodeExecution {
  id uuid [pk, default: `gen_random_uuid()`]
  executionId uuid [not null, ref: > Execution.id]
  nodeId uuid [not null]
  nodeTypeKey varchar(160) [not null]
  attemptNumber int [not null, default: 1]
  status NodeExecutionStatus [not null, default: 'PENDING']
  inputHash char(64) [note: 'Optional hash for correlation; input body is not stored by default.']
  outputHash char(64) [note: 'Optional hash for correlation; output body is not stored by default.']
  startedAt timestamptz
  finishedAt timestamptz
  durationMs bigint
  errorCode varchar(120)
  errorMessageSanitized text
  retryDelayMs bigint
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (executionId, nodeId, attemptNumber) [unique, name: 'uq_node_executions_attempt']
    (executionId, status) [name: 'idx_node_executions_execution_status']
    (nodeTypeKey, errorCode, startedAt) [name: 'idx_node_executions_failure_analytics']
  }

  Note: 'One node attempt inside an Execution. High-volume table suitable for time partitioning and short production-log retention.'
}

Table ExecutionEvent {
  id uuid [pk, default: `gen_random_uuid()`]
  executionId uuid [not null, ref: > Execution.id]
  nodeExecutionId uuid [ref: >? NodeExecution.id]
  sequenceNumber bigint [not null, note: 'Monotonic within an Execution for replaying Customer Monitor state.']
  eventType varchar(100) [not null]
  severity varchar(24) [not null, default: 'INFO']
  messageKey varchar(160) [note: 'Localization key for customer-friendly monitor text.']
  metadataJson jsonb [note: 'Strictly sanitized metadata such as row count or domain; no raw payload.']
  occurredAt timestamptz [not null]

  indexes {
    (executionId, sequenceNumber) [unique, name: 'uq_execution_events_sequence']
    (eventType, occurredAt) [name: 'idx_execution_events_type_time']
  }

  Note: 'Ordered event stream for progress, activity detail, cancellation, permission change, and troubleshooting. Apply retention independently from durable audit.'
}

Table CapabilityInvocation {
  id uuid [pk, default: `gen_random_uuid()`]
  executionId uuid [not null, ref: > Execution.id]
  nodeExecutionId uuid [not null, ref: > NodeExecution.id]
  capabilityId uuid [not null, ref: > CapabilityDefinition.id]
  productPermissionGrantId uuid [ref: >? ProductPermissionGrant.id]
  credentialBindingId uuid [ref: >? CredentialBinding.id]
  status CapabilityInvocationStatus [not null]
  targetHost varchar(255) [note: 'Network hostname only; do not store full URLs containing user data or secrets.']
  requestBytes bigint
  responseBytes bigint
  startedAt timestamptz
  finishedAt timestamptz
  durationMs bigint
  errorCode varchar(120)
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (executionId, createdAt) [name: 'idx_capability_invocations_execution']
    (capabilityId, status, createdAt) [name: 'idx_capability_invocations_analytics']
  }

  Note: 'Privacy-preserving Capability Broker activity. It proves which gate was used without persisting payload or credential values.'
}

Table ProductDailyMetric {
  productVersionId uuid [not null, ref: > ProductVersion.id]
  metricDate date [not null]
  totalRuns bigint [not null, default: 0]
  successfulRuns bigint [not null, default: 0]
  failedRuns bigint [not null, default: 0]
  cancelledRuns bigint [not null, default: 0]
  permissionDeniedRuns bigint [not null, default: 0]
  resourceLimitedRuns bigint [not null, default: 0]
  p95DurationMs bigint
  topErrorCode varchar(120)
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    (productVersionId, metricDate) [pk]
  }

  Note: 'Pre-aggregated operational metrics for Publisher/Admin dashboards. It prevents expensive scans of retained execution events.'
}

