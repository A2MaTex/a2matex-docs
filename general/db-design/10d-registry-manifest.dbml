Project A2MaTeX_registry_manifest {
  database_type: 'PostgreSQL'
  Note: '''Registry & Manifest module view.

Tables in the primary module group are complete. Tables in reference_stubs are intentionally reduced cross-module projections used only to preserve readable relationships in dbdiagram.io.

The canonical schema remains 10-database-design.dbml.'''
}

// ============================================================

Enum PublisherStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

Enum NodeDefinitionKind {
  SYSTEM
  CUSTOM_TEMPLATE
  PRIVATE_LIBRARY
}

Enum NodeRuntimeKind {
  SYSTEM_HANDLER
  CUSTOM_SCRIPT
  SCHEDULER_PRIMITIVE
}

Enum RevisionCapabilityOrigin {
  DECLARED
  DETECTED
  EFFECTIVE
}

Enum CredentialOwnerType {
  CUSTOMER
  PUBLISHER
}

// ============================================================

Table CapabilityDefinition {
  id uuid [pk, default: `gen_random_uuid()`]
  key varchar(160) [not null, unique, note: 'Examples: network.request, camera.capture, bluetooth.scan.']
  displayName varchar(160) [not null]
  description text [not null]
  androidPermissions jsonb [note: 'Android permissions that may be required by OS/API level.']
  isSensitive boolean [not null, default: false]
  isActive boolean [not null, default: true]
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  Note: 'Canonical capability registry shared by Studio, Build, Review, Launcher, and Runtime Agent.'
}

Table NodeDefinition {
  id uuid [pk, default: `gen_random_uuid()`]
  publisherId uuid [ref: >? Publisher.id, note: 'Null for platform-owned System Nodes; populated for private library nodes.']
  key varchar(200) [not null, unique, note: 'Globally stable key. Publisher private keys should be namespace-prefixed, for example publisher.<publisher-id>.<name>.']
  kind NodeDefinitionKind [not null]
  displayName varchar(180) [not null]
  description text
  isActive boolean [not null, default: true]
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    (kind, isActive) [name: 'idx_node_definitions_kind_active']
  }

  Note: 'Stable node identity in the System Node Registry or future Publisher Private Node Library.'
}

Table NodeDefinitionVersion {
  id uuid [pk, default: `gen_random_uuid()`]
  nodeDefinitionId uuid [not null, ref: > NodeDefinition.id]
  version varchar(64) [not null, note: 'Semantic version or platform-compatible version string.']
  runtimeKind NodeRuntimeKind [not null]
  inputSchema jsonb [not null]
  configSchema jsonb [not null]
  outputSchema jsonb [not null]
  handlerRef varchar(500) [not null, note: 'Platform handler key or immutable module reference; never arbitrary executable path.']
  handlerHash char(64) [not null]
  defaultResourcePolicy jsonb
  publishedAt timestamptz
  deprecatedAt timestamptz
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (nodeDefinitionId, version) [unique, name: 'uq_node_definition_versions_version']
  }

  Note: 'Immutable versioned node contract and handler reference. Project pin exact versions.'
}

Table NodeVersionCapability {
  nodeDefinitionVersionId uuid [not null, ref: > NodeDefinitionVersion.id]
  capabilityId uuid [not null, ref: > CapabilityDefinition.id]
  requirementJson jsonb [note: 'Optional domain, scope, or platform-specific requirement template.']

  indexes {
    (nodeDefinitionVersionId, capabilityId) [pk]
  }

  Note: 'Capabilities inherently required by a System Node or reusable node definition version.'
}

Table RevisionCapability {
  id uuid [pk, default: `gen_random_uuid()`]
  revisionId uuid [not null, ref: > WorkflowRevision.id]
  capabilityId uuid [not null, ref: > CapabilityDefinition.id]
  origin RevisionCapabilityOrigin [not null]
  purpose text
  configurationHash char(64) [note: 'Hash of security-relevant capability configuration without secret values.']
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (revisionId, capabilityId, origin) [unique, name: 'uq_revision_capabilities_origin']
  }

  Note: 'Declared, detected, and final effective capability sets. Validation fails when detected behavior is not covered by declarations.'
}

Table RevisionAllowedDomain {
  id uuid [pk, default: `gen_random_uuid()`]
  revisionId uuid [not null, ref: > WorkflowRevision.id]
  origin RevisionCapabilityOrigin [not null]
  scheme varchar(16) [not null, default: 'https']
  hostPattern varchar(255) [not null, note: 'UAT should prefer exact hosts. Wildcards require stricter review.']
  port int
  purpose text
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (revisionId, origin, scheme, hostPattern, port) [unique, name: 'uq_revision_allowed_domains']
  }

  Note: 'Declared/detected/effective network allowlist for review and package-manifest generation.'
}

Table RevisionCredentialSlot {
  id uuid [pk, default: `gen_random_uuid()`]
  revisionId uuid [not null, ref: > WorkflowRevision.id]
  slotKey varchar(160) [not null, note: 'Stable product-facing slot key, for example customer-google-account.']
  providerKey varchar(120) [not null]
  ownerType CredentialOwnerType [not null]
  requiredScopes jsonb [not null]
  purpose text [not null]
  isRequired boolean [not null, default: true]
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (revisionId, slotKey) [unique, name: 'uq_revision_credential_slots_key']
  }

  Note: 'Credential requirements captured by a Revision. This table contains only metadata and requested scopes, never token material.'
}

// ============================================================

Table Publisher {
  id uuid [pk]
  displayName varchar(180)
  slug varchar(120)
  status PublisherStatus
  createdAt timestamptz

  Note: 'Reference stub for a table owned by another module. Only identity fields are shown here; use the owning module file for the complete definition.'
}

Table WorkflowRevision {
  id uuid [pk]
  revisionNumber int
  semanticHash char(64)
  createdAt timestamptz

  Note: 'Reference stub for a table owned by another module. Only identity fields are shown here; use the owning module file for the complete definition.'
}
