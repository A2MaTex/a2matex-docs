Project A2MaTeX_publisher_billing {
  database_type: 'PostgreSQL'
  Note: '''Publisher & Billing module view.

Tables in the primary module group are complete. Tables in reference_stubs are intentionally reduced cross-module projections used only to preserve readable relationships in dbdiagram.io.

The canonical schema remains 10-database-design.dbml.'''
}

// ============================================================

Enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

Enum PublisherStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

Enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

// ============================================================

Table Publisher {
  id uuid [pk, default: `gen_random_uuid()`]
  ownerUserId uuid [not null, ref: > User.id]
  slug varchar(120) [not null, unique]
  displayName varchar(180) [not null]
  description text
  status PublisherStatus [not null, default: 'PENDING']
  verifiedAt timestamptz
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  Note: 'Publishing identity. One user may own a Publisher while future team members are represented by PublisherMember.'
}

Table PublisherMember {
  publisherId uuid [not null, ref: > Publisher.id]
  userId uuid [not null, ref: > User.id]
  memberRole varchar(40) [not null, note: 'OWNER, DEVELOPER, RELEASE_MANAGER, or other future publisher-scoped role.']
  status varchar(24) [not null, default: 'ACTIVE']
  invitedByUserId uuid [ref: >? User.id]
  joinedAt timestamptz
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (publisherId, userId) [pk]
    (userId, status) [name: 'idx_publisher_members_user_status']
  }

  Note: 'Future-ready publisher collaboration table. Team collaboration UI is outside UAT, but ownership should not be hard-wired into every domain table.'
}

Table SubscriptionPlan {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(80) [not null, unique]
  name varchar(120) [not null]
  description text
  isActive boolean [not null, default: true]
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  Note: 'Publisher plan definition. UAT may seed FREE and INTERNAL_TEST plans.'
}

Table SubscriptionPlanLimit {
  id uuid [pk, default: `gen_random_uuid()`]
  planId uuid [not null, ref: > SubscriptionPlan.id]
  limitKey varchar(100) [not null, note: 'Examples: registered_projects, publish_requests, build_minutes, artifact_bytes, log_retention_days.']
  limitValue bigint [note: 'Null may mean unlimited; interpretation is defined by limitKey.']
  configJson jsonb [note: 'Optional structured settings for limits not representable by one integer.']
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    (planId, limitKey) [unique, name: 'uq_plan_limits_key']
  }

  Note: 'Normalized configurable plan limits. Node count must not be introduced as a commercial paywall.'
}

Table PublisherSubscription {
  id uuid [pk, default: `gen_random_uuid()`]
  publisherId uuid [not null, ref: > Publisher.id]
  planId uuid [not null, ref: > SubscriptionPlan.id]
  status SubscriptionStatus [not null]
  startsAt timestamptz [not null]
  currentPeriodStart timestamptz [not null]
  currentPeriodEnd timestamptz [not null]
  cancelledAt timestamptz
  externalBillingRef varchar(255) [note: 'Nullable for FREE and Admin-managed UAT subscriptions.']
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    (publisherId, status) [name: 'idx_publisher_subscriptions_active']
    currentPeriodEnd [name: 'idx_publisher_subscriptions_period_end']
  }

  Note: 'Publisher commercial subscription. Downgrade must not delete Artifact still required by Customers or retention policy.'
}

Table PublisherUsageCounter {
  id uuid [pk, default: `gen_random_uuid()`]
  publisherId uuid [not null, ref: > Publisher.id]
  periodStart timestamptz [not null]
  periodEnd timestamptz [not null]
  usageKey varchar(100) [not null]
  usedValue bigint [not null, default: 0]
  reservedValue bigint [not null, default: 0, note: 'Reserved before starting expensive operations to avoid quota races.']
  lockVersion int [not null, default: 1, note: 'Optimistic locking counter.']
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    (publisherId, periodStart, periodEnd, usageKey) [unique, name: 'uq_publisher_usage_period_key']
  }

  Note: 'Period-scoped usage and reservation counters for builds, Submission, storage, and similar server-side resources.'
}

// ============================================================

Table User {
  id uuid [pk]
  username varchar(255)
  email text
  status UserStatus
  createdAt timestamptz

  Note: 'Reference stub for a table owned by another module. Only identity fields are shown here; use the owning module file for the complete definition.'
}
