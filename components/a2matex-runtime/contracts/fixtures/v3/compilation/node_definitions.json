              "required": ["xPercent", "yPercent"],
              "additionalProperties": false
            }
          },
          {
            "mode": "SELECTOR_ID",
            "bindingSchema": {
              "type": "object",
              "properties": {
                "selector_id": {
                  "type": "string",
                  "pattern": "^[^\\s:]+:id/[^\\s/]+$"
                }
              },
              "required": ["selector_id"],
              "additionalProperties": false
            }
          }
        ]
      }
    },
    "capabilities": ["android.device.control"]
  },
