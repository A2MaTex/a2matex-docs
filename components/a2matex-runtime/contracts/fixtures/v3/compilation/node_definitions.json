                "value": { "types": ["string", "number", "boolean"] }
              }
            },
            "WORKFLOW_INPUT": { "fields": ["inputName"] },
            "NODE_OUTPUT": { "fields": ["nodeId", "field"] },
            "FLOW_VARIABLE": { "fields": ["name"] },
            "GLOBAL_VARIABLE": { "fields": ["name"] }
          }
        }
      },
      "required": ["value"],
      "additionalProperties": false
