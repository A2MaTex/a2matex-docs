  {
    "type": "flow.switch",
    "name": "Switch",
    "description": "Route to the first matching rule or the default branch.",
    "category": "FLOW",
    "runtimeHandler": "flow.switch",
    "minimumRuntimeVersion": "0.1.0",
    "defaultTimeoutMs": 1000,
    "configSchema": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "minimumItems": 1,
          "maximumItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid", "readOnly": true },
              "operator": {
                "type": "string",
                "options": [
                  {
                    "value": "EQ",
                    "supportedTypes": ["string", "number", "boolean"],
                    "operandCount": 1
                  },
                  {
                    "value": "NE",
                    "supportedTypes": ["string", "number", "boolean"],
                    "operandCount": 1
                  },
                  {
                    "value": "LT",
                    "supportedTypes": ["number"],
                    "operandCount": 1
                  },
                  {
                    "value": "LTE",
                    "supportedTypes": ["number"],
                    "operandCount": 1
                  },
                  {
                    "value": "GT",
                    "supportedTypes": ["number"],
                    "operandCount": 1
                  },
                  {
                    "value": "GTE",
                    "supportedTypes": ["number"],
                    "operandCount": 1
                  },
                  {
                    "value": "CONTAINS",
                    "supportedTypes": ["string"],
                    "operandCount": 1
                  },
                  {
                    "value": "NOT_CONTAINS",
                    "supportedTypes": ["string"],
                    "operandCount": 1
                  },
                  {
                    "value": "STARTS_WITH",
                    "supportedTypes": ["string"],
                    "operandCount": 1
                  },
                  {
                    "value": "ENDS_WITH",
                    "supportedTypes": ["string"],
                    "operandCount": 1
                  },
                  {
                    "value": "IS_EMPTY",
                    "supportedTypes": ["string"],
                    "operandCount": 0
                  },
                  {
                    "value": "IS_NOT_EMPTY",
                    "supportedTypes": ["string"],
                    "operandCount": 0
                  },
                  {
                    "value": "IS_TRUE",
                    "supportedTypes": ["boolean"],
                    "operandCount": 0
                  },
                  {
                    "value": "IS_FALSE",
                    "supportedTypes": ["boolean"],
                    "operandCount": 0
                  }
                ]
              }
            },
            "required": ["id", "operator"],
            "additionalProperties": false
          }
        }
      },
      "required": ["rules"],
      "additionalProperties": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "value": {
          "bindingKinds": {
            "LITERAL": {
              "fields": {
                "value": { "types": ["string", "number", "boolean"] }
              }
            },
            "WORKFLOW_INPUT": { "fields": ["inputName"] },
            "NODE_OUTPUT": { "fields": ["nodeId", "field"] },
            "FLOW_VARIABLE": { "fields": ["name"] },
            "GLOBAL_VARIABLE": { "fields": ["name"] }
          }
        }
      },
      "dynamicInputs": {
        "ruleOperand": {
          "bindingKeyFrom": "config.rules[].id",
          "operandCountFrom": "config.rules[].operator",
          "bindingKinds": {
            "LITERAL": {
              "fields": {
                "value": { "types": ["string", "number", "boolean"] }
              }
            },
            "WORKFLOW_INPUT": { "fields": ["inputName"] },
            "NODE_OUTPUT": { "fields": ["nodeId", "field"] },
            "FLOW_VARIABLE": { "fields": ["name"] },
            "GLOBAL_VARIABLE": { "fields": ["name"] }
          }
        }
      },
      "required": ["value"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "outputPorts": {
      "ports": ["default", "error"],
      "dynamicPorts": { "keysFrom": "config.rules[].id" }
    },
    "editorHints": {},
    "capabilities": []
  },
